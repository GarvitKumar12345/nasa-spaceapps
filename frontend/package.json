{
  "name": "skyshift-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:json": "vitest run --reporter=json --outputFile=../validation/results/vitest.json",
    "e2e": "playwright test",
    "gen:contracts": "cd ../backend && uv run python scripts/export_contracts.py && cd ../frontend && json2ts --input src/api/contracts.schema.json --output src/api/contracts.gen.ts --unreachableDefinitions --additionalProperties false --bannerComment \"/* Generated from backend/skyshift/contracts.py (scripts/export_contracts.py + json2ts). Do not edit; run npm run gen:contracts. */\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
